classDiagram
    class Owner {
        +String name
        +Dict~DayOfWeek, int~ availability
        +List~String~ preferences
        +List~Pet~ pets
        +List~Task~ tasks
        +List~Task~ pendingTasks
        +List~Task~ completedTasks
        +addPet(pet: Pet)
        +removePet(pet: Pet)
        +updateAvailability(newSchedule: Dict~DayOfWeek, int~)
        +setPreferences(preferences: List~String~)
    }

    class Pet {
        +String name
        +String breed
        +float weight
        +int age
        +Owner owner
        +List~Task~ tasks
        +List~Task~ pendingTasks
        +List~Task~ completedTasks
        +addTask(task: Task)
        +removeTask(task: Task)
        +getTaskHistory() List~Task~
    }

    class Task {
        +String name
        +String description
        +List~DayOfWeek~ days
        +time startTime
        +int durationMinutes
        +Frequency frequency
        +Priority priority
        +Pet pet
        +bool completed
        +date dueDate
        +Owner owner
        +isRecurringOn(day: DayOfWeek) bool
        +updatePriority(newPriority: Priority)
        +updateDuration(minutes: int)
        +markComplete() Task
        +markIncomplete()
    }

    class SchedulePlanner {
        +generateDailyPlan(pet: Pet, owner: Owner, availableMinutes: int) List~Task~
        +sortByPriority(tasks: List~Task~) List~Task~
        +sortByTime(tasks: List~Task~) List~Task~
        +filterByAvailability(tasks: List~Task~, owner: Owner) List~Task~
        +filterByCompletion(tasks: List~Task~, completed: bool) List~Task~
        +detectConflicts(tasks: List~Task~) List~String~
        +explainPlan(plan: List~Task~) String
    }

    class DayOfWeek {
        <<enumeration>>
        MONDAY
        TUESDAY
        WEDNESDAY
        THURSDAY
        FRIDAY
        SATURDAY
        SUNDAY
    }

    class Priority {
        <<enumeration>>
        HIGH = 1
        MEDIUM = 2
        LOW = 3
    }

    class Frequency {
        <<enumeration>>
        ONCE
        TWICE
        THREE_TIMES
        FOUR_TIMES
        DAILY
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "0..*" --> "1" Owner : owner
    Pet "1" *-- "0..*" Task : has
    Task "0..*" --> "1" Pet : pet
    Owner ..> Task : tasks derived via pets
    Task ..> Task : markComplete creates next daily occurrence
    Task ..> DayOfWeek : days
    Task ..> Priority : priority
    Task ..> Frequency : frequency
    Owner ..> DayOfWeek : availability keys
    SchedulePlanner ..> Task : sorts, filters, flags conflicts in
    SchedulePlanner ..> Pet : plans for
    SchedulePlanner ..> Owner : checks availability
